#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// try tossing in a bunch of includes from filippo's config
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/mouse_settings.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors/mouse_setting.dtsi>


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I &kp O &kp P
&kp A  &kp S &kp D &kp F &kp G   &kp H &kp J &kp K &kp L &kp SEMI
&bootloader &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR
&bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bootloader
          &kp N1 &kp N2 &kp N3   &kp N4 &kp N5 &kp N6
            >;
        };
    };
};